{
  "name": "informacao-protegida",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && pnpm check:secrets",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "db:start": "node scripts/start-local-db.mjs",
    "db:stop": "supabase stop",
    "db:env": "node scripts/local-env.mjs",
    "db:types": "node scripts/generate-types.mjs",
    "db:test": "node scripts/test-local-db.mjs",
    "db:check": "node scripts/check-local-db.mjs",
    "db:test:cli": "supabase test db --network-id informacao-protegida-local",
    "db:migrate": "supabase migration up --local",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:check": "node scripts/check-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.2",
    "@opennextjs/cloudflare": "1.20.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=10.30.1 <11"
  }
}
