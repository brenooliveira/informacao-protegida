# Copie para .env.local. Execute pnpm db:env para usar chaves REAIS da stack local.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Reservado à consulta de e-mails da Fase 4; o verificador de senhas usa a API real diretamente.
BREACH_PROVIDER=mock
HIBP_RPM=10
HIBP_TIMEOUT_MS=10000
HIBP_MIN_CHECK_INTERVAL_HOURS=24
# Segredos só no servidor; nunca adicionar NEXT_PUBLIC_ às variáveis abaixo.
# SUPABASE_SERVICE_ROLE_KEY=
# HIBP_API_KEY=
# RESEND_API_KEY=
# CRON_SECRET=

# Gerado por pnpm db:env para a lista de espera local. Nunca público.
# WAITLIST_HMAC_SECRET=

# Ativar apenas para publicação aprovada ou auditoria SEO local. Padrão: false.
SITE_INDEXABLE=false
